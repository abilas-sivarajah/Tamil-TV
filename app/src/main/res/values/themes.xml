<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Leanback-Basis: liefert Zeilen-, Header- und Fokus-Styles der TV-UI -->
    <style name="Theme.TvClient" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/brand_accent</item>
    </style>

    <!-- Theme der Poster-Karten: setzt nur die Textfarben, Rest kommt von Leanback -->
    <style name="CardTheme" parent="Theme.Leanback">
        <item name="android:colorAccent">@color/brand_accent</item>
    </style>

    <!-- Player: echtes Vollbild, schwarzer Hintergrund, keine Systemleisten -->
    <style name="Theme.TvClient.Player" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@color/brand_accent</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Update-Dialog: schwebt ueber dem Startbildschirm, Hintergrund stark abgedunkelt -->
    <style name="Theme.TvClient.UpdateDialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/update_dialog_background</item>
        <item name="android:colorAccent">@color/brand_accent</item>
        <item name="android:backgroundDimAmount">0.85</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <style name="UpdateButton">
        <item name="android:background">@drawable/update_button_background</item>
        <item name="android:textColor">@color/update_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minWidth">140dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
